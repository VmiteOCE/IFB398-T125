  "paths": {
    "/games": {
      "post": {
        "tags": [
          "games"
        ],
        "summary": "Create a new game",
        "description": "Creates a new game in the database with an auto-incrementing ID value. Accepts JSON or URL-encoded form data.",
        "operationId": "createGame",
        "requestBody": {
          "$ref": "#/components/requestBodies/GameInputRequestBody"
        },
        "responses": {
          "201": {
            "description": "Success response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameCreateResponse"
                }
              }
            }
          },
          "500": {
            "description": "Database error"
          }
        },
        "security": [
          {
            "petstore_auth": [
              "write:pets",
              "read:pets"
            ]
          }
        ]
      },
      "get": {
        "tags": [
          "games"
        ],
        "summary": "Get all game details",
        "description": "Retrieves a list of all games stored in the database.",
        "operationId": "getAllGames",
        "responses": {
          "200": {
            "description": "Success response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAllGamesResponse"
                }
              }
            }
          },
          "404": {
            "description": "No games in database",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NoGamesErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Database error"
          }
        },
        "security": [
          {
            "petstore_auth": [
              "write:pets",
              "read:pets"
            ]
          }
        ]
      }
    },
    "/games/{game_id}": {
      "get": {
        "tags": [
          "games"
        ],
        "summary": "Get details of an existing game",
        "description": "Gets the details of a game with the entered game_id.",
        "operationId": "getGameDetails",
        "parameters": [
          {
            "name": "game_id",
            "in": "path",
            "required": true,
            "description": "The unique ID of the game to get details of",
            "schema": {
              "type": "integer",
              "example": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetSingleGameResponse"
                }
              }
            }
          },
          "404": {
            "description": "Game not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MissingGameErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Database error"
          }
        },
        "security": [
          {
            "petstore_auth": [
              "write:pets",
              "read:pets"
            ]
          }
        ]
      },
      "put": {
        "tags": [
          "games"
        ],
        "summary": "Update details of an existing game",
        "description": "Updates the details of a game with the entered game_id. Accepts JSON or URL-encoded form data.",
        "operationId": "updateGame",
        "parameters": [
          {
            "name": "game_id",
            "in": "path",
            "required": true,
            "description": "The unique ID of the game to update",
            "schema": {
              "type": "integer",
              "example": 1
            }
          }
        ],
        "requestBody": {
          "$ref": "#/components/requestBodies/GameInputRequestBody"
        },
        "responses": {
          "200": {
            "description": "Success response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameUpdateResponse"
                }
              }
            }
          },
          "404": {
            "description": "Game not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MissingGameErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Database error"
          }
        },
        "security": [
          {
            "petstore_auth": [
              "write:pets",
              "read:pets"
            ]
          }
        ]
      },
      "delete": {
        "tags": [
          "games"
        ],
        "summary": "Delete an existing game",
        "description": "Deletes a game with the entered game_id. Additionally deletes all events associated with the entered game.",
        "operationId": "deleteGame",
        "parameters": [
          {
            "name": "game_id",
            "in": "path",
            "required": true,
            "description": "The unique ID of the game to delete",
            "schema": {
              "type": "integer",
              "example": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameDeleteResponse"
                }
              }
            }
          },
          "404": {
            "description": "Game not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MissingGameErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Database error"
          }
        },
        "security": [
          {
            "petstore_auth": [
              "write:pets",
              "read:pets"
            ]
          }
        ]
      }
    },
    "/events": {
      "post": {
        "tags": [
