    "/user": {
      "post": {
        "tags": [
          "user"
        ],
        "summary": "Create user.",
        "description": "This can only be done by the logged in user.",
        "operationId": "createUser",
        "requestBody": {
          "description": "Created user object",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/User"
              }
            },
            "application/xml": {
              "schema": {
                "$ref": "#/components/schemas/User"
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/User"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "default": {
            "description": "Unexpected error"
          }
        }
      }
    },
    "/user/login": {
      "get": {
        "tags": [
          "user"
        ],
        "summary": "Logs user into the system.",
        "description": "Log into the system.",
        "operationId": "loginUser",
        "parameters": [
          {
            "name": "username",
            "in": "query",
            "description": "The user name for login",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "password",
            "in": "query",
            "description": "The password for login in clear text",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "successful operation",
            "headers": {
              "X-Rate-Limit": {
                "description": "calls per hour allowed by the user",
                "schema": {
                  "type": "integer",
                  "format": "int32"
                }
              },
              "X-Expires-After": {
                "description": "date in UTC when token expires",
                "schema": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            },
            "content": {
              "application/xml": {
                "schema": {
                  "type": "string"
                }
              },
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Invalid username/password supplied"
          },
          "default": {
            "description": "Unexpected error"
          }
        }
      }
    },
    "/user/logout": {
      "get": {
        "tags": [
          "user"
        ],
        "summary": "Logs out current logged in user session.",
        "description": "Log user out of the system.",
        "operationId": "logoutUser",
        "parameters": [],
        "responses": {
          "200": {
            "description": "successful operation"
          },
          "default": {
            "description": "Unexpected error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GameCreate": {
        "type": "object",
        "required": [
          "game_name",
          "vs_team",
          "start_time",
          "game_status"
        ],
        "properties": {
          "game_name": {
            "type": "string",
            "example": "Test Game"
          },
          "vs_team": {
            "type": "string",
            "example": "VS Team Name"
          },
          "start_time": {
            "type": "string",
            "description": "ISO string representation of game start time",
            "example": "2026-06-01T14:30:00Z"
          },
          "game_status": {
            "type": "string",
            "description": "Status of current game",
            "default": "scheduled",
            "enum": [
              "scheduled",
              "in-progress",
              "completed",
              "cancelled"
            ],
            "example": "scheduled"
          }
        }
      },
      "GameFull": {
        "allOf": [
          {
            "type": "object",
            "required": [
              "game_id"
            ],
            "properties": {
              "game_id": {
                "type": "integer",
                "description": "Auto-incremented unique ID for the game",
                "example": 1
              }
            }
          },
          {
            "$ref": "#/components/schemas/GameCreate"
          }
        ]
      },
      "EventCreate": {
        "type": "object",
        "required": [
          "game_id",
          "event_code",
          "zone_id",
          "team_id",
          "game_clock",
          "game_half"
        ],
        "properties": {
          "game_id": {
            "type": "integer",
            "description": "Associated game_id",
            "example": 1
          },
          "event_code": {
            "type": "string",
            "enum": [
              "A",
              "C",
              "E",
              "K",
              "L",
              "M",
              "P",
              "R",
              "S",
              "T",
              "V",
              "Y"
            ],
            "example": "P"
          },
          "zone_id": {
            "type": "string",
            "enum": [
              "A",
              "B",
              "M",
              "C",
              "D"
            ],
            "example": "M"
          },
          "team_id": {
            "type": "integer",
            "description": "Team 1 - Reds, Team 2 - VS team",
            "enum": [
              1,
              2
            ],
            "example": 1
          },
          "game_clock": {
            "type": "integer",
            "description": "Match time (in seconds)",
            "minimum": 0,
            "example": 20
          },
          "game_half": {
            "type": "integer",
            "enum": [
              1,
              2
            ],
            "example": 1
          }
        }
      },
      "EventFull": {
        "allOf": [
          {
            "type": "object",
            "required": [
              "event_id"
            ],
            "properties": {
              "event_id": {
                "type": "integer",
                "description": "Auto-incremented unique ID for the event",
                "example": 1
              }
            }
          },
          {
            "$ref": "#/components/schemas/EventCreate"
          }
        ]
      },
      "GameCreateResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "boolean",
            "example": false
          },
          "message": {
            "type": "string",
            "example": "Game created successfully"
          },
          "game_id": {
            "type": "integer",
            "example": 1
          }
        }
      },
      "GameUpdateResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "boolean",
            "example": false
          },
          "message": {
            "type": "string",
            "example": "Game updated successfully"
          },
          "game_id": {
            "type": "integer",
            "example": 1
          }
        }
      },
      "GameDeleteResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "boolean",
            "example": false
          },
          "message": {
            "type": "string",
            "example": "Game deleted successfully"
          },
          "game_id": {
            "type": "integer",
            "example": 1
          }
        }
      },
      "EventCreateResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "boolean",
            "example": false
          },
          "message": {
            "type": "string",
            "example": "Event logged successfully"
          },
          "game_id": {
            "type": "integer",
            "example": 1
          }
        }
      },
      "EventUpdateResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "boolean",
            "example": false
          },
          "message": {
            "type": "string",
            "example": "Event updated successfully"
          },
          "game_id": {
            "type": "integer",
            "example": 1
          }
        }
      },
      "EventDeleteResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "boolean",
            "example": false
          },
          "message": {
            "type": "string",
            "example": "Event deleted successfully"
          },
          "game_id": {
            "type": "integer",
            "example": 1
          }
        }
      },
      "GetAllGamesResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "boolean",
            "example": false
          },
          "message": {
            "type": "string",
            "example": "Success"
          },
          "games": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GameFull"
            },
            "example": [
              {
                "game_id": 1,
                "game_name": "Season 2026 - Week 12",
                "vs_team": "Waratahs",
                "start_time": "2026-05-25T14:30:00.000Z",
                "game_status": "completed"
              },
              {
                "game_id": 2,
                "game_name": "Practice Game vs Storm",
                "vs_team": "Storm",
                "start_time": "2026-06-01T18:00:00.000Z",
                "game_status": "scheduled"
              }
            ]
          }
        }
      },
      "GetSingleGameResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "boolean",
            "example": false
          },
          "message": {
            "type": "string",
            "example": "Success"
          },
          "game": {
            "$ref": "#/components/schemas/GameFull"
          }
        }
      },
      "MissingGameErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "boolean",
            "example": true
          },
          "message": {
            "type": "string",
            "example": "Game not found"
          }
        }
      },
      "NoGamesErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "boolean",
            "example": true
          },
          "message": {
            "type": "string",
            "example": "No games found"
          }
        }
      },
      "GetEventResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "boolean",
            "example": false
          },
          "message": {
            "type": "string",
            "example": "Success"
          },
          "event": {
            "$ref": "#/components/schemas/EventFull"
          }
        }
      },
      "MissingEventErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "boolean",
            "example": true
          },
          "message": {
            "type": "string",
            "example": "Event not found"
          }
        }
      },
      "NoEventsErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "boolean",
            "example": true
          },
          "message": {
            "type": "string",
            "example": "No Events found"
          }
        }
      },
      "GetGameEventsResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "boolean",
            "example": false
          },
          "message": {
            "type": "string",
            "example": "Success"
          },
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EventFull"
            },
            "example": [
              {
                "event_id": 1,
                "game_id": 1,
                "event_code": "P",
