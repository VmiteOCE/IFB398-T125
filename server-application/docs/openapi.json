        "operationId": "deleteEvent",
        "parameters": [
          {
            "name": "event_id",
            "in": "path",
            "required": true,
            "description": "The unique ID of the game event to delete",
            "schema": {
              "type": "integer",
              "example": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameDeleteResponse"
                }
              }
            }
          },
          "404": {
            "description": "Event not found",
            "content": {
              "application/json": {
